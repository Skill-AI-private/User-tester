# LLM API Keys (Chọn ít nhất 1 nhà cung cấp để chạy phân tích thị giác)
OPENAI_API_KEY="sk-..."
# hoặc
GEMINI_API_KEY="AIzaSy..."

# Cấu hình kiểm thử
DEFAULT_MODEL="gpt-4o" # hoặc "gemini-1.5-pro", "gemini-2.0-flash"
HEADLESS=false          # Đặt false để nhìn thấy trình duyệt AI tự thao tác
MAX_STEPS=10           # Số bước tương tác tối đa cho 1 kịch bản
SCREENSHOT_DIR="./screenshots"
REPORTS_DIR="./reports"
